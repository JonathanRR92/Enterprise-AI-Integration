# Salesforce OAuth
SALESFORCE_INSTANCE_URL=https://your-domain.my.salesforce.com
SALESFORCE_CLIENT_ID=your_client_id
SALESFORCE_CLIENT_SECRET=your_client_secret

# Snowflake connection
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=your_private_key_passphrase
SNOWFLAKE_ROLE=AI_SALES_READER
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=AI_MCP_SERVICE
SNOWFLAKE_WAREHOUSE=AI_DEV_WH
SNOWFLAKE_DATABASE=ENTERPRISE_AI
SNOWFLAKE_SCHEMA=SALES
SNOWFLAKE_PRIVATE_KEY_PATH=keys/ai_mcp_service.p8